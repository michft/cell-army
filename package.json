{
  "name": "conferenceapp",
  "private": true,
  "version": "0.1.0",
  "description": "AWS Summit Sydney agenda planner",
  "packageManager": "pnpm@10.30.3",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "refresh:agenda": "node ./scripts/fetchAgenda.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "^55.0.23",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "overrides": {
      "react-dom": "19.2.0"
    }
  }
}
